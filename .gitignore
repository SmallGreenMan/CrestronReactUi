# ---------------------------------------------------------------------------
# Altair Demo — React + TypeScript + Vite
# ---------------------------------------------------------------------------

# Dependencies
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/releases
!.yarn/plugins
!.yarn/sdks
!.yarn/versions

# Build output
dist/
dist-ssr/
build/
*.tsbuildinfo

# Vite / tooling caches
.vite/
node_modules/.vite/
node_modules/.tmp/
.eslintcache
.stylelintcache
*.timestamp-*.mjs

# Environment — the presenter WebSocket URL lives here (VITE_PRESENTER_WS_URL).
# Keep local overrides out of the repo; commit `.env.example` instead.
.env
.env.*
!.env.example
*.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Test / coverage output
coverage/
.nyc_output/
playwright-report/
test-results/
blob-report/
.playwright/

# Editors and IDEs
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
*.swp
*.sw?
*.suo
*.ntvs*
*.njsproj

# Claude Code — share project config, keep personal overrides local
.claude/settings.local.json

# OS cruft
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
